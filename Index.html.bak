    <div class="nav-cta">
      <a href="#">시작하기</a>
    </div>
    <button class="hamburger" aria-label="메뉴 열기" onclick="document.getElementById('mobile-menu').classList.add('open')">
      <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</header>

<!-- ── Mobile Menu ── -->
<div class="mobile-menu" id="mobile-menu">
  <div class="mobile-menu-header">
    <span class="nav-brand" style="color: var(--ink);">
      <svg viewBox="0 0 26 26" fill="none">
        <path d="M10 3h6v7.5l5.5 11H4.5l5.5-11V3z" stroke="#5db8a6" stroke-width="1.4" stroke-linejoin="round" fill="none"/>
        <line x1="9" y1="3" x2="17" y2="3" stroke="var(--ink)" stroke-width="1.4" stroke-linecap="round"/>
        <circle cx="11.5" cy="17" r="1.2" fill="#cc785c" opacity="0.9"/>
        <circle cx="15" cy="19" r="0.9" fill="#5db8a6" opacity="0.8"/>
      </svg>
      Ans2Quest
    </span>
    <button class="mobile-menu-close" aria-label="메뉴 닫기" onclick="document.getElementById('mobile-menu').classList.remove('open')">
      <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
    </button>
