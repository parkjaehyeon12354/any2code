{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",

  "platform": {
    "apiRuntime": "node:22"
  },

  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Resource-Policy": "same-origin",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  },

  "routes": [
    {
      "route": "/",
      "rewrite": "/Index.html"
    },
    {
      "route": "/community",
      "rewrite": "/community.html"
    },
    {
      "route": "/guide",
      "rewrite": "/guide.html"
    },
    {
      "route": "/research",
      "rewrite": "/research/index.html"
    },
    {
      "route": "/research/topics",
      "rewrite": "/research/topics.html"
    },
    {
      "route": "/research/hypothesis",
      "rewrite": "/research/hypothesis.html"
    },
    {
      "route": "/research/experiment",
      "rewrite": "/research/experiment.html"
    },
    {
      "route": "/research/record",
      "rewrite": "/research/record.html"
    },
    {
      "route": "/research/report",
      "rewrite": "/research/report.html"
    },
    {
      "route": "/research/examples",
      "rewrite": "/research/examples.html"
    },
    {
      "route": "/science",
      "rewrite": "/science.html"
    },
    {
      "route": "/login",
      "rewrite": "/login.html"
    },
    {
      "route": "/signup",
      "rewrite": "/signup.html"
    },
    {
      "route": "/welcome",
      "rewrite": "/welcome.html"
    },
    {
      "route": "/terms",
      "rewrite": "/terms.html"
    },
    {
      "route": "/privacy",
      "rewrite": "/privacy.html"
    },
    {
      "route": "/admin",
      "rewrite": "/admin.html"
    },
    {
      "route": "/settings",
      "rewrite": "/settings.html"
    },
    {
      "route": "/simulation/pendulum",
      "rewrite": "/simulation/pendulum.html"
    },
    {
      "route": "/simulation/electromagnetic-induction",
      "rewrite": "/simulation/electromagnetic-induction.html"
    },
    {
      "route": "/q/*",
      "rewrite": "/post.html"
    },
    {
      "route": "/api/*",
      "headers": { "Cache-Control": "no-store" }
    }
  ],

  "responseOverrides": {
    "404": { "rewrite": "/Index.html" }
  },

  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  }
}
